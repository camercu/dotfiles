Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host pihole
    Hostname pi.hole
    User pi
    IdentityFile ~/.ssh/pihole_rsa

Host homelab homelab.local homelab.home.arpa
    Hostname homelab.local
    # IPv4: sshd can't match a link-local IPv6 source against the key's from=
    AddressFamily inet
    User cadmin
    IdentityFile ~/.ssh/id_rsa_homelab
    IdentitiesOnly yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_rsa

Host cloudcar
    Hostname 13.52.183.108
    Port 2200
    User ubuntu
    IdentityFile ~/.ssh/id_rsa_cloudcar

Host cloudcar-mayhem
    Hostname 18.117.8.71  # mayhem
    Port 2200
    User ubuntu
    IdentityFile ~/.ssh/id_rsa_cc_mayhem

Host hashbang
    HostName de1.hashbang.sh
    IdentitiesOnly yes
    User cr4nk
    IdentityFile ~/.ssh/id_rsa_hashbang

Host gitlab.mayhem.dev
    Hostname gitlab.mayhem.dev
    IdentitiesOnly yes
    User git
    IdentityFile ~/.ssh/id_rsa_mayhem

