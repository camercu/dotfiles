#!/bin/sh
#
# Two lint source paths because this file is reachable under two names: its
# real path (common/.local/bin/dotsync) and the repo symlink
# (scripts/install-dotfiles.sh). Either way the sourced libs resolve.
# shellcheck source-path=SCRIPTDIR/../../../scripts/lib
# shellcheck source-path=SCRIPTDIR/lib
set -eu

SCRIPT_PATH=$0

while [ -L "$SCRIPT_PATH" ]; do
  LINK_DIR=$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
  SCRIPT_PATH=$(readlink "$SCRIPT_PATH")
  case "$SCRIPT_PATH" in
    /*) ;;
    *) SCRIPT_PATH=$LINK_DIR/$SCRIPT_PATH ;;
  esac
done

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
DOTFILE_DIR=$(CDPATH='' cd -- "$SCRIPT_DIR/../../.." && pwd -P)
# shellcheck source=logging.sh
. "$DOTFILE_DIR/scripts/lib/logging.sh"
# shellcheck source=checks.sh
. "$DOTFILE_DIR/scripts/lib/checks.sh"

MODE=sync
AUTO_DISCOVER=0
packages=

usage() {
  cat <<'EOF'
Usage: dotsync [--unlink] [--auto-discover]

Without options, dotsync (re)links the managed dotfile packages using stow,
then points ~/.claude at ~/.config/claude.

Options:
  --unlink  remove all managed dotfile symlinks for the active package set
  --auto-discover  compatibility no-op; stow handles link discovery
  -h, --help  show this help message
EOF
}

has_command() {
  command -v "$1" >/dev/null 2>&1
}

# Generated / per-machine files that can appear inside a package dir but must
# never be symlinked into $HOME. stow does not honor .gitignore, so without
# this it aborts the whole run when one of these (e.g. .zcompdump written by
# the system /etc/zshrc, or a Finder .DS_Store) collides with a real file.
STOW_IGNORE='(^|/)(\.zcompdump.*|\.zsh_history|\.DS_Store|.*\.zwc)$'

# run_stow PACKAGE FLAGS...: FLAGS are plain options such as -n -R.
run_stow() {
  package_name=$1
  shift

  (
    cd "$DOTFILE_DIR"
    if has_command stow; then
      stow --ignore="$STOW_IGNORE" "$@" "$package_name"
      exit 0
    fi

    if has_command nix-shell; then
      nix-shell -p stow --run "stow --ignore='$STOW_IGNORE' $* $package_name"
      exit 0
    fi

    error "missing dependency 'stow' for dotfile installation"
    exit 1
  )
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --unlink)
        MODE='unlink'
        ;;
      --auto-discover)
        AUTO_DISCOVER=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        error "unknown option: $1"
        usage >&2
        exit 1
        ;;
    esac
    shift
  done
}

select_packages() {
  packages="common"

  if is_macos; then
    packages="$packages macos"
    if is_admin; then
      packages="$packages nix-darwin"
    fi
  elif is_linux; then
    packages="$packages linux"
  fi
}

# repo_git PACKAGE ARGS...: git in a package of this repo. The repo is trusted
# even when another user owns it (a shared mount): the safe.directory entry
# for it ships in the git config dotsync has yet to link.
repo_git() {
  package_dir=$DOTFILE_DIR/$1
  shift
  git -c safe.directory="$DOTFILE_DIR" -C "$package_dir" "$@"
}

# unfold_repo_links DIR: replace each link from $HOME down to DIR that an
# older dotsync made into the repo (stow folded the dir) with an empty real
# dir; stow then relinks the shipped files one by one. Returns 1 at a link
# that leaves the repo: not ours to replace.
unfold_repo_links() {
  rest=${1#"$HOME"/}
  path=$HOME
  while [ -n "$rest" ]; do
    part=${rest%%/*}
    case $rest in
      */*) rest=${rest#*/} ;;
      *) rest= ;;
    esac
    path=$path/$part
    [ -L "$path" ] || continue
    target=$(CDPATH='' cd -P -- "$path" 2>/dev/null && pwd) || target=
    case $target in
      "$DOTFILE_DIR"/*)
        rm -- "$path"
        mkdir -- "$path"
        info "replaced $path, a link into the repo, with a real dir"
        ;;
      *) return 1 ;;
    esac
  done
}

# move_repo_state PACKAGE DIR: move the ignored files (tool state) in a marked
# repo dir to the same place under $HOME, then drop the dirs that emptied:
# stow would link an empty repo dir into the next HOME that lacks it.
move_repo_state() {
  # Raw non-ASCII names; git still quotes names with quotes, backslashes or
  # control characters, which this loop cannot pass to mv.
  repo_git "$1" -c core.quotePath=false ls-files --others --ignored --exclude-standard -- "$2" |
    while IFS= read -r file; do
      case $file in
        \"*)
          warn "cannot move $file out of $DOTFILE_DIR/$1; move it by hand"
          continue
          ;;
      esac
      if [ -e "$HOME/$file" ] || [ -L "$HOME/$file" ]; then
        warn "$HOME/$file exists, so $DOTFILE_DIR/$1/$file stays in the repo"
        continue
      fi
      mkdir -p "$(dirname "$HOME/$file")"
      mv -- "$DOTFILE_DIR/$1/$file" "$HOME/$file"
      info "moved $file from the repo to $HOME/$file"
    done
  find "$DOTFILE_DIR/$1/$2" -depth -mindepth 1 -type d -empty -delete
}

# A package dir whose .gitignore starts with `*` takes tool state beside the
# files the repo ships. stow links a dir missing from $HOME whole, which would
# put that state in the repo: make it a real dir so stow links file by file.
# A dir an older dotsync already linked whole gets a real dir, and the state
# written through that link moves out of the repo.
make_state_dirs() {
  package_name=$1

  # Tracked files only: untracked worktrees inside a package carry copies.
  # Without the list, linking would put tool state in the repo: stop.
  if ! tracked=$(repo_git "$package_name" ls-files); then
    error "cannot list tracked files in $package_name; nothing linked"
    exit 1
  fi
  # stow also folds a dir below a marked one (~/.local/share), so each dir
  # there that holds shipped files gets the same treatment.
  state_dirs=
  for rel in $(printf '%s\n' "$tracked" | grep '\(^\|/\)\.gitignore$'); do
    [ "$(head -n 1 "$DOTFILE_DIR/$package_name/$rel")" = '*' ] || continue
    marked=$(dirname "$rel")
    state_dirs="$state_dirs $marked $(printf '%s\n' "$tracked" | awk -v d="$marked" '
      index($0, d "/") == 1 {
        n = split(substr($0, length(d) + 2), part, "/"); p = d
        for (i = 1; i < n; i++) { p = p "/" part[i]; if (!seen[p]++) print p }
      }')"
  done

  # Resolve every dir before changing any: unfolding ~/.config for one would
  # hide that the next also lived in the repo.
  in_repo=
  for dir in $state_dirs; do
    resolved=$(CDPATH='' cd -P -- "$HOME/$dir" 2>/dev/null && pwd) || continue
    [ "$resolved" = "$DOTFILE_DIR/$package_name/$dir" ] && in_repo="$in_repo $dir"
  done

  for dir in $state_dirs; do
    if unfold_repo_links "$HOME/$dir"; then
      mkdir -p "$HOME/$dir"
    else
      warn "$HOME/$dir sits under a link out of the repo; left as is"
    fi
  done
  for dir in $in_repo; do
    move_repo_state "$package_name" "$dir"
  done
}

apply_packages() {
  action=-R
  if [ "$MODE" = "unlink" ]; then
    action=-D
  fi

  for package_name in $packages; do
    if [ "$MODE" != "unlink" ]; then
      # Repair only once stow is known to succeed: an aborted run would leave
      # an unfolded ~/.config holding nothing but the state dirs.
      if ! dry_run=$(run_stow "$package_name" -n "$action" 2>&1); then
        printf '%s\n' "$dry_run" >&2
        error "stow cannot link $package_name; stopped before changing it"
        exit 1
      fi
      make_state_dirs "$package_name"
    fi
    info "stow $action $package_name"
    run_stow "$package_name" "$action"
  done
}

# Claude Code may have made a real ~/.claude before the first link. Point it
# at the linked ~/.config/claude only after stow: moved there earlier, its
# settings.json blocks the stow link.
migrate_claude() {
  [ "$MODE" = "unlink" ] && return 0
  zsh "$DOTFILE_DIR/scripts/migrate-claude-config.zsh" ||
    warn "Claude config migration failed; see above"
}

report_result() {
  if [ "$AUTO_DISCOVER" -eq 1 ]; then
    warn "--auto-discover is ignored in stow mode"
  fi

  if [ "$MODE" = "unlink" ]; then
    success "managed dotfile links removed"
  else
    success "dotfiles linked"
  fi
}

parse_args "$@"
select_packages
apply_packages
migrate_claude
report_result
