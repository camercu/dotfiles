theme = catppuccin-macchiato
font-family = "MesloLGS Nerd Font Mono"
font-size = 12

copy-on-select = clipboard
macos-option-as-alt = true
mouse-hide-while-typing = true
quit-after-last-window-closed = true
scrollback-limit = 8388608
window-decoration = true
# ssh-terminfo: install xterm-ghostty terminfo on hosts we ssh into (cached).
# ssh-env: fall back to TERM=xterm-256color where that install is not possible.
shell-integration-features = sudo,ssh-terminfo,ssh-env
