{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "env": {
    "CLAUDE_CODE_SHELL": "/run/current-system/sw/bin/bash"
  },
  "autoContinueAtUsageLimit": true,
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "Edit",
      "WebFetch"
    ],
    "deny": [
      "AskUserQuestion"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rtk git push:*)",
      "Bash(jj git push:*)",
      "Bash(jj push:*)",
      "Bash(rm:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo yank:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/common/.config/claude/hooks/guard-push.sh\"",
            "timeout": 120,
            "statusMessage": "guard: rebase before push"
          },
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/common/.config/claude/hooks/guard-commit-chain.sh\"",
            "statusMessage": "guard: no test+commit chain"
          },
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/common/.config/claude/hooks/guard-destructive.sh\"",
            "statusMessage": "guard: destructive command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/common/.config/claude/hooks/validate-skill.sh\"",
            "timeout": 120,
            "statusMessage": "validate skill"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/starship-claude",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "starship-claude@starship-claude": true
  },
  "tui": "fullscreen",
  "editorMode": "vim",
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
