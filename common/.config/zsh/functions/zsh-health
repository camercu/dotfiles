# zsh-health: quick syntax and dependency check for this zsh config.
local root="${ZDOTDIR:-$HOME/.config/zsh}"
local -a files deps missing insecure trusted unexpected
local -i warned=0 failed=0
local file

files=(
    "$root/.zshrc"
    "$HOME"/.zshenv(N)
    "$root"/p10k*.zsh(N)
    "$root"/lib/***/*.(sh|zsh)(N-)
    "$root"/env/***/*.(sh|zsh)(N-)
    "$root"/conf.d/***/*.(sh|zsh)(N-)
    "$root"/functions/[^_]*(N-.)
    "$root"/completions/_*(N)
    "$root"/plugins/***/*.plugin.zsh(N)
)

# One file per zsh -n: it parses only its first operand and treats the rest
# as positional parameters, so batching would check just the first file.
for file in $files; do
    if ! command zsh -n -- "$file"; then
        error "syntax check failed: $file"
        failed=1
    fi
done
(( failed )) && return 1

deps=(git awk sed grep)
missing=()
for dep in $deps; do
    is-installed "$dep" || missing+="$dep"
done

if (( $#missing > 0 )); then
    warn "missing recommended tools: ${missing[*]}"
    warned=1
fi

autoload -Uz compaudit
insecure=( ${(f)"$(compaudit 2>/dev/null)"} )
# /opt/homebrew is cadmin-owned by design (the documented admin split; see
# the compinit -u comment in .zshrc). Warning about it every run would bury
# a genuinely unexpected insecure path in permanent noise, so report the
# Homebrew paths as trusted and warn only about anything else.
trusted=( ${(M)insecure:#/opt/homebrew/*} )
unexpected=( ${insecure:#/opt/homebrew/*} )
if (( $#unexpected > 0 )); then
    warn "compaudit found insecure paths:"
    print -l -- "${unexpected[@]}" >&2
    warned=1
fi
if (( $#trusted > 0 )); then
    debug "compaudit: $#trusted trusted Homebrew paths (cadmin-owned; see .zshrc)"
fi

if (( warned )); then
    warn "zsh config health check passed with warnings"
else
    success "zsh config health check passed"
fi
