<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the Ollama server (Homebrew formula `ollama`) with its environment
  under version control. Ollama.app is not installed: it re-registers
  itself as a login item on every launch and takes port 11434 at boot.

  Only the daily (non-admin) account runs the server; stow links this file
  for every account, so the script exits 0 for admins and launchd, which
  restarts only on failure, leaves it stopped. Same when the formula is not
  installed.

  Per-model context sizes live in common/.config/ollama/*.Modelfile;
  OLLAMA_CONTEXT_LENGTH is the default for models without one.
  Log: ~/.ollama/logs/serve.log (server.log belongs to Ollama.app).
  Restart: launchctl kickstart -k gui/$(id -u)/com.cameron.ollama-serve
  After editing this file, kickstart is not enough (launchd keeps the old
  copy): launchctl bootout gui/$(id -u)/com.cameron.ollama-serve, then
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<this file>.
  bootstrap can fail with "Input/output error" right after bootout; retry.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cameron.ollama-serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <!-- sh, not a bare exec: launchd does not expand $HOME -->
    <string>id -Gn | tr ' ' '\n' | grep -qx admin &amp;&amp; exit 0; bin=/opt/homebrew/bin/ollama; [ -x "$bin" ] || exit 0; mkdir -p "$HOME/.ollama/logs"; export OLLAMA_MODELS="$HOME/.cache/ollama/models"; exec "$bin" serve &gt;&gt;"$HOME/.ollama/logs/serve.log" 2&gt;&amp;1</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_CONTEXT_LENGTH</key>
    <string>8192</string>
    <key>OLLAMA_FLASH_ATTENTION</key>
    <string>1</string>
    <key>OLLAMA_KV_CACHE_TYPE</key>
    <string>q8_0</string>
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>-1</string>
    <key>OLLAMA_NO_CLOUD</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- Retry a failed start once a minute, not launchd's default 10 s: when
       Ollama.app holds the port, each failed start appends ~1.7 KB to
       serve.log, which is never rotated. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
